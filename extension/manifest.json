{
  "manifest_version": 3,
  "name": "Jumia Price Monitor",
  "version": "1.0.0",
  "description": "Watch Jumia products across 8 countries and get price-change alerts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jumia Price Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://www.jumia.com.eg/*",
    "*://jumia.com.eg/*",
    "*://www.jumia.com.gh/*",
    "*://jumia.com.gh/*",
    "*://www.jumia.ci/*",
    "*://jumia.ci/*",
    "*://www.jumia.co.ke/*",
    "*://jumia.co.ke/*",
    "*://www.jumia.ma/*",
    "*://jumia.ma/*",
    "*://www.jumia.com.ng/*",
    "*://jumia.com.ng/*",
    "*://www.jumia.sn/*",
    "*://jumia.sn/*",
    "*://www.jumia.ug/*",
    "*://jumia.ug/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.jumia.com.eg/*",
        "*://jumia.com.eg/*",
        "*://www.jumia.com.gh/*",
        "*://jumia.com.gh/*",
        "*://www.jumia.ci/*",
        "*://jumia.ci/*",
        "*://www.jumia.co.ke/*",
        "*://jumia.co.ke/*",
        "*://www.jumia.ma/*",
        "*://jumia.ma/*",
        "*://www.jumia.com.ng/*",
        "*://jumia.com.ng/*",
        "*://www.jumia.sn/*",
        "*://jumia.sn/*",
        "*://www.jumia.ug/*",
        "*://jumia.ug/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
