# Copy to .env and adjust locally. Do not put real secrets in git.
#
# Local docker compose uses the DB_* / RABBITMQ_* / REDIS_* hostnames below
# (postgres, rabbitmq, redis). On Railway, prefer the plugin-injected URLs
# instead: DATABASE_URL, REDIS_URL, RABBITMQ_URL (or AMQP_URL).

# --- Postgres (compose) ---
DB_USER=jumia_user
DB_PASSWORD=changeme
DB_NAME=jumia_db
# DB_HOST=postgres
# DB_PORT=5432
# Railway Postgres plugin (overrides DB_* when set):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- RabbitMQ (compose) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_VHOST=/
# Railway (overrides RABBITMQ_HOST when set):
# RABBITMQ_URL=amqp://user:pass@host:5672/
# AMQP_URL=amqp://user:pass@host:5672/

# --- Redis (compose) ---
# REDIS_HOST=redis
# REDIS_PORT=6379
# Railway Redis plugin (overrides REDIS_HOST when set):
# REDIS_URL=redis://default:pass@host:6379

# Used by POST /internal/ingest (fixture/demo price updates; not live Jumia).
# Production (Railway): ENABLE_INGEST=false and a long random INGEST_TOKEN.
ENABLE_INGEST=true
INGEST_TOKEN=dev-ingest-token

# Scraper pacing. With no watches the scraper idles and does not hit Jumia.
CHECK_INTERVAL_MINUTES=15
SCRAPE_INTERVAL_SECONDS=900
SCRAPE_CYCLE_SECONDS=30
SCRAPE_POLITE_MIN_SECONDS=2
SCRAPE_POLITE_MAX_SECONDS=5
STARTUP_DELAY_SECONDS=5

# Price history: keep raw points this many days, then 1 row per product per UTC day.
# Set 0 to disable downsampling.
HISTORY_RETENTION_DAYS=90
HISTORY_RETENTION_INTERVAL_SECONDS=3600

# Browser CORS. Default * plus chrome-extension://* (always allowed).
# Production: comma-separated HTTPS origins, or leave * if only the extension calls the API.
# CORS_ORIGINS=*
# CORS_ORIGINS=https://api-xxxx.up.railway.app
# CORS_ORIGIN_REGEX=

# Optional stubs — leave blank to log-only
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
