# Copy to .env and adjust locally. Do not put real secrets in git.
DB_USER=jumia_user
DB_PASSWORD=changeme
DB_NAME=jumia_db

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Used by POST /internal/ingest (fixture/demo price updates; not live Jumia)
ENABLE_INGEST=true
INGEST_TOKEN=dev-ingest-token

# Scraper pacing. With no watches the scraper idles and does not hit Jumia.
SCRAPE_INTERVAL_SECONDS=900
SCRAPE_CYCLE_SECONDS=30
SCRAPE_POLITE_MIN_SECONDS=2
SCRAPE_POLITE_MAX_SECONDS=5
STARTUP_DELAY_SECONDS=5

# Optional stubs — leave blank to log-only
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
